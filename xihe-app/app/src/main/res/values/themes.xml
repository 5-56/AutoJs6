<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.Xihe" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/xihe_primary</item>
        <item name="colorPrimaryDark">@color/xihe_primary_dark</item>
        <item name="colorAccent">@color/xihe_accent</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        
        <item name="android:statusBarColor">@color/xihe_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Theme without ActionBar -->
    <style name="Theme.Xihe.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.Xihe.Splash" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
